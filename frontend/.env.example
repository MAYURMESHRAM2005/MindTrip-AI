# Firebase web app config
# Firebase console → Project settings → Your apps → Web app (</> icon)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: override the API base URL (defaults to /api via the Vite proxy)
# VITE_API_URL=http://localhost:5000/api

# Google Maps JavaScript API browser key (for interactive maps on the Maps page
# and the itinerary map card). Create it separately from the backend key and
# restrict it by HTTP referrers (e.g. http://localhost:5173/*) and to the Maps
# JavaScript API only. When empty, map panels show an "unavailable" notice;
# all geocoding/routing/places data still flows through the backend.
VITE_GOOGLE_MAPS_BROWSER_KEY=
