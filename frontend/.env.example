# Backend API base. In dev, Vite proxies /api to the backend so this is optional.
# If you serve the backend from another host, set VITE_API_URL to its origin.
VITE_API_URL=

# Google OAuth is handled server-side (backend/.env) - no client secrets in the frontend.
# GOOGLE_CLIENT_ID is only needed if you use the Google Identity Services button.
VITE_GOOGLE_CLIENT_ID=

# All external API keys (Geoapify, OpenWeatherMap, Amadeus, etc.) live ONLY in backend/.env.
# The frontend never holds API keys — it calls the backend, which proxies external providers.
