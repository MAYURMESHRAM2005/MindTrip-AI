# ============ SERVER ============
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ============ DATABASE ============
MONGODB_URI=mongodb://127.0.0.1:27017/travelmind
# For production use MongoDB Atlas, e.g.:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/travelmind

# ============ AUTH ============
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# ============ GOOGLE OAUTH ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:5000/api/auth/google/callback

# ============ AI ============
GEMINI_API_KEY=
# Gemini 3.5 Flash - fast, capable default. Override with any model ID, e.g. gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash

# ============ GOOGLE MAPS PLATFORM ============
GOOGLE_MAPS_API_KEY=

# ============ WEATHER ============
OPENWEATHER_API_KEY=

# ============ AMADEUS (FLIGHTS + HOTELS) ============
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# ============ TRAIN / BUS (configured provider endpoints, optional) ============
TRAIN_API_URL=
TRAIN_API_KEY=
BUS_API_URL=
BUS_API_KEY=

# ============ IMAGES (optional) ============
UNSPLASH_ACCESS_KEY=

# ============ EMAIL (SMTP for verification / password reset) ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TravelMind AI <no-reply@travelmind.app>

# ============ CLOUDINARY (optional - image storage) ============
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
